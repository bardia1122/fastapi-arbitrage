{
  "id": null,
  "uid": "arb-full",
  "title": "Arbitrage Service - Full Metrics (App + DB)",
  "timezone": "browser",
  "schemaVersion": 38,
  "version": 2,
  "refresh": "5s",
  "panels": [
    {
      "type": "timeseries",
      "title": "⏱ Exchange Response Time (s)",
      "datasource": "Prometheus",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "avg(rate(exchange_response_time_seconds_sum[5m]) / rate(exchange_response_time_seconds_count[5m])) by (exchange)",
          "legendFormat": "{{exchange}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "min": 0
        },
        "overrides": []
      }
    },
    {
      "type": "bargauge",
      "title": "📊 Exchange Requests (ok/error)",
      "datasource": "Prometheus",
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "rate(exchange_requests_total[5m])",
          "legendFormat": "{{exchange}} ({{status}})",
          "refId": "A"
        }
      ],
      "options": {
        "orientation": "horizontal",
        "displayMode": "lcd",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      }
    },
    {
      "type": "timeseries",
      "title": "💰 Last Arbitrage Value per Symbol",
      "datasource": "Prometheus",
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "arbitrage_last_diff_value",
          "legendFormat": "{{symbol}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0
        }
      }
    },
    {
      "type": "timeseries",
      "title": "💰 Last Diff Percent per Symbol",
      "datasource": "Prometheus",
      "gridPos": {
        "x": 12,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "arbitrage_last_diff_percent",
          "legendFormat": "{{symbol}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0
        }
      }
    },
    {
      "type": "stat",
      "title": "🟢 DB Up",
      "datasource": "Prometheus",
      "gridPos": {
        "x": 0,
        "y": 16,
        "w": 6,
        "h": 5
      },
      "targets": [
        {
          "expr": "pg_up",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bool",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": 0
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          }
        }
      }
    },
    {
      "type": "timeseries",
      "title": "📈 Active Connections",
      "datasource": "Prometheus",
      "gridPos": {
        "x": 6,
        "y": 16,
        "w": 6,
        "h": 5
      },
      "targets": [
        {
          "expr": "pg_stat_activity_count{datname!~\"template.*\"}",
          "legendFormat": "{{datname}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none"
        }
      }
    },
    {
      "type": "timeseries",
      "title": "💾 DB Size (bytes)",
      "datasource": "Prometheus",
      "gridPos": {
        "x": 12,
        "y": 16,
        "w": 6,
        "h": 5
      },
      "targets": [
        {
          "expr": "pg_database_size_bytes{datname!~\"template.*\"}",
          "legendFormat": "{{datname}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes"
        }
      }
    },
    {
      "type": "timeseries",
      "title": "⚙️ Transactions Committed / Rolled Back",
      "datasource": "Prometheus",
      "gridPos": {
        "x": 18,
        "y": 16,
        "w": 6,
        "h": 5
      },
      "targets": [
        {
          "expr": "rate(pg_stat_database_xact_commit{datname!~\"template.*\"}[5m])",
          "legendFormat": "{{datname}} commit",
          "refId": "A"
        },
        {
          "expr": "rate(pg_stat_database_xact_rollback{datname!~\"template.*\"}[5m])",
          "legendFormat": "{{datname}} rollback",
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops"
        }
      }
    }
  ],
  "time": {
    "from": "now-15m",
    "to": "now"
  },
  "annotations": {
    "list": []
  }
}